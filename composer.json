{
  "name": "prettylittleplugins/restaurant-menu-block",
  "description": "Restaurant Menu Block – with Allergen & Dietary Filters",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "PrettyLittlePlugins\\RestaurantMenuBlock\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PrettyLittlePlugins\\RestaurantMenuBlock\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.1"
    }
  }
}
